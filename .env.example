# Copy this file to ".env" and fill in ONE of the API keys below.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (bash)
#
# .env is already in .gitignore, so it will not be committed.
# Without any key the chatbot still works - it falls back to the built-in
# offline engine that reads the database directly.

# --- Google Gemini (has a free tier) --------------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model. Default is gemini-3.8-flash.
# Run `python assistant_gemini.py --models` to list what your key can use.
#GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic Claude (paid) ----------------------------------------------
# Key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Which engine to use --------------------------------------------------
# Leave unset to pick automatically: gemini, then claude, then offline.
# Set to "gemini", "claude" or "offline" to pin one.
#CHAT_ENGINE=gemini
